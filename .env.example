# Database Configuration (PostgreSQL in production, SQLite in local dev)
DATABASE_URL="file:./dev.db"

# JWT and Authentication Secrets
AUTH_SECRET="your-secure-jwt-secret-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Platform Settings
NEXT_PUBLIC_PLATFORM_NAME="FALKO"
PLATFORM_COMMISSION_UYU=25
MINIMUM_WITHDRAWAL_USD=20
DEFAULT_GUARANTEE_DAYS=7

# Storage (Local signed token simulation / S3 ready)
STORAGE_DRIVER="local"
STORAGE_SECRET="your-private-download-signing-key"

# Payment Providers (MOCK | STRIPE | MERCADOPAGO | PAYPAL)
PAYMENT_PROVIDER="MOCK"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Email Providers (MOCK | RESEND | SENDGRID | SMTP)
EMAIL_PROVIDER="MOCK"
RESEND_API_KEY=""
EMAIL_FROM="notifications@falko.io"
